{
  "name": "@flomatai/helpers",
  "version": "0.1.0",
  "description": "Shared helpers for flomatai examples: LLM resolution from env vars, SQLite orchestrator factory",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@flomatai/core": "workspace:*",
    "@flomatai/provider-anthropic": "workspace:*",
    "@flomatai/provider-openai-compat": "workspace:*",
    "@flomatai/state-sqlite": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.0.0"
  }
}
