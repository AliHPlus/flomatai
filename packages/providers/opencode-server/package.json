{
  "name": "@flomatai/provider-opencode-server",
  "version": "0.1.1",
  "description": "OpenCode server (opencode serve) provider for flomatai — wraps the session-based HTTP API as a standard LLMProvider",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@flomatai/core": "^0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.0.0",
    "@flomatai/core": "workspace:*"
  }
}
