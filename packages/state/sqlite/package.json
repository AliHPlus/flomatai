{
  "name": "@flomatai/state-sqlite",
  "version": "0.1.0",
  "description": "SQLite persistence adapter for flomatai — run history, caching, checkpoint/resume",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "better-sqlite3": "^9.6.0",
    "@flomatai/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.0.0",
    "@types/better-sqlite3": "^7.6.11"
  }
}
