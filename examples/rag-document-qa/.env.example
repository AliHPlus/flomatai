# RAG Document Q&A Pipeline — Environment Variables

# LLM Provider (choose one)
ANTHROPIC_API_KEY=sk-ant-your-key-here
# OPENAI_API_KEY=sk-your-key-here
# OPENCODE_BASE_URL=http://localhost:3000

# Optional
# LLM_MODEL=claude-3-5-sonnet-20241022
# CHUNK_SIZE=500       # characters per chunk (default: 500)
# CHUNK_OVERLAP=50     # overlap between chunks (default: 50)
# TOP_K=5              # number of chunks to retrieve (default: 5)
