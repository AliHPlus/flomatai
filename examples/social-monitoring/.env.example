# Social Monitoring Pipeline — Environment Variables

# LLM Provider (choose one)
ANTHROPIC_API_KEY=sk-ant-your-key-here
# OPENAI_API_KEY=sk-your-key-here
# OPENCODE_BASE_URL=http://localhost:3000

# Brand/topic to monitor
BRAND_NAME=Acme Corp
KEYWORDS=acme,acmecorp,acme corp

# RSS feeds to monitor (comma-separated URLs)
# RSS_FEEDS=https://news.ycombinator.com/rss,https://lobste.rs/rss

# Optional
# MOCK=true                         # use mock data (no network calls)
# LLM_MODEL=claude-3-5-sonnet-20241022
# OUTPUT_DIR=./output               # where to save daily digest
# MIN_RELEVANCE=0.3                 # min relevance score to include (0-1)
