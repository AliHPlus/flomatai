# ETL + Python Analysis Pipeline — Environment Variables

# LLM Provider (choose one)
ANTHROPIC_API_KEY=sk-ant-your-key-here
# OPENAI_API_KEY=sk-your-key-here
# OPENCODE_BASE_URL=http://localhost:3000

# Optional: path to Python executable (default: python3)
# PYTHON_PATH=python3

# Optional: use bundled synthetic data instead of real data sources
# MOCK=true

# Optional: paths to your own data files (overrides bundled data)
# SALES_CSV=./data/sales.csv
# USERS_JSON=./data/users.json
